# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Dữ liệu thô / đã xử lý (tải lại bằng script)
data/raw/
data/processed/
data/interim/*
# Artifact nhỏ của bản nộp: commit để tái lập đánh giá không cần chạy lại (xem README)
!data/interim/full_v2/
data/interim/full_v2/*
!data/interim/full_v2/queries_v2.csv
!data/interim/full_v2/bm25_s10/
!data/interim/full_v2/e5_s2/
data/interim/full_v2/*/candidates.jsonl
!data/interim/source_qrels_v1/
# negatives.jsonl: sinh lại bằng build_source_qrels.py, không bước nào đọc
data/interim/source_qrels_v1/negatives.jsonl
!data/interim/pilot_v2/
data/interim/pilot_v2/*
!data/interim/pilot_v2/pilot_queries_v2.csv
!data/interim/query_processing_v2/
*.parquet
*.arrow

# Bản sao HTML thô dùng xem mẫu trong EDA
reports/data_stats/samples/*.html

# Model, index, file lớn
models/*/model/
checkpoints/
indexes/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.npy
*.npz
*.faiss
*.index

# Cache HF
.cache/
data/raw/.cache/

# Log tạm
logs/*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# pytest
.pytest_tmp/
.scratch/

# Log từng văn bản bị loại ở bước lọc 1-3 (~10 MB); tái tạo bằng scripts/prepare_data.py
logs/filtered_out.tsv

# Bản nộp: chỉ giữ run.trec + summary.json của runs; bỏ candidates (lớn, tái tạo được)
runs/**/candidates.jsonl
# Dữ liệu runtime của demo và log pipeline
data/app/
logs/pipeline/
# Gói artifact lớn (phát hành ngoài git)
release/
scratch/
