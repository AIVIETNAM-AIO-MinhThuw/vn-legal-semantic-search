# Giữ diff ổn định giữa Windows và Linux.
* text=auto eol=lf

# Script Windows cần CRLF khi được dùng trực tiếp trên Windows.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Không chuyển đổi file nhị phân.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.parquet binary
*.arrow binary
*.bin binary
*.safetensors binary
*.pt binary
*.pth binary
*.ckpt binary
*.onnx binary
*.npy binary
*.npz binary
*.faiss binary
*.index binary

# Artifact dữ liệu và kết quả: giữ nguyên byte vì SHA-256 được ghi trong summary/manifest/FROZEN.md
data/** -text
runs/** -text
reports/results/** -text
